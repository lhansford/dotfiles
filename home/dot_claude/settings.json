{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "autoMemoryEnabled": false,
  "spinnerVerbs": { "mode": "replace", "verbs": ["Rolling the dice"] },
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git status:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "default"
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "ghostty",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // \"Waiting for your input\"' | { read -r m; notify-send -a \"Claude Code\" -i utilities-terminal \"Claude Code\" \"$m\"; } 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  }
}
